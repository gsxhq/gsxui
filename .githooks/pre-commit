#!/bin/sh
# Pre-commit: refuse to commit .gsx / .go files that gsx fmt / gofmt would
# change. Install once per clone with `make hooks`. Checks the STAGED
# content (not the working copy), so `git add -p` partial stages are judged
# on what will actually land in the commit.
#
# Deliberately does not auto-format and re-stage: that would silently
# sweep unstaged hunks of the same file into the commit.
#
# gsx fmt exit codes: 0 clean, 1 differs, 2 read/parse failure. A parse
# failure is reported and blocks the commit too — the file is broken.
set -u

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.gsx' '*.go')
[ -n "$files" ] || exit 0

bad=""
for f in $files; do
	case "$f" in
	*.gsx) git show ":$f" | go tool gsx fmt -l -stdin-filename "$f" >/dev/null; rc=$? ;;
	*.go)  out=$(git show ":$f" | gofmt -l 2>&1); rc=$?; [ $rc -eq 0 ] && [ -n "$out" ] && rc=1 ;;
	esac
	[ "$rc" -eq 0 ] || bad="$bad $f"
done

if [ -n "$bad" ]; then
	echo "pre-commit: unformatted (or unparsable) files — run go tool gsx fmt -w / gofmt -w, then re-stage:" >&2
	for f in $bad; do echo "  $f" >&2; done
	exit 1
fi
